{
  "name": "pratirakshak-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots": "playwright test --grep @shot",
    "record": "node -e \"console.log('Recording is done by the team: open /?mode=story (Space/arrow keys = next beat, H = hide chrome, C = captions).')\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.1.0",
    "@fontsource/ibm-plex-sans": "5.1.0",
    "@fontsource/source-serif-4": "5.1.0",
    "@react-three/drei": "9.115.0",
    "@react-three/fiber": "8.17.10",
    "d3": "7.9.0",
    "framer-motion": "11.11.17",
    "maplibre-gl": "4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/d3": "7.4.3",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
