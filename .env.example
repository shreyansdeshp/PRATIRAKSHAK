# Copy to .env (never committed). Everything here is optional — the app runs keyless.

# Optional MapTiler key to upgrade basemap/satellite tiles (SPEC §11.3). Leave blank to use keyless sources.
MAPTILER_KEY=

# Optional Copernicus CDS key, only if ERA5 climatology is preferred over Open-Meteo (SPEC §7.4).
CDS_API_KEY=

# API port for `dev`
API_PORT=8000
